# 设置目标架构为x86
export ARCH=x86

# 编译器设置
CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -O2

# 目标文件
TARGETS = reader_x86 writer_x86

# 源文件
SRCS = reader.c writer.c

# 对象文件
OBJS = reader_x86.o writer_x86.o

.PHONY: all clean

all: $(TARGETS)

# 编译reader程序
reader_x86: reader.c
	@echo "编译x86版本的reader程序..."
	$(CC) $(CFLAGS) -o $@ $<
	@echo "编译完成！输出文件: $@"

# 编译writer程序
writer_x86: writer.c
	@echo "编译x86版本的writer程序..."
	$(CC) $(CFLAGS) -o $@ $<
	@echo "编译完成！输出文件: $@"

# 清理生成的文件
clean:
	@echo "清理x86编译输出..."
	rm -f $(OBJS) $(TARGETS)
	@echo "清理完成！"

# 安装到系统（需要root权限）
install: all
	cp reader_x86 /usr/local/bin/
	cp writer_x86 /usr/local/bin/

# 卸载
uninstall:
	rm -f /usr/local/bin/reader_x86
	rm -f /usr/local/bin/writer_x86