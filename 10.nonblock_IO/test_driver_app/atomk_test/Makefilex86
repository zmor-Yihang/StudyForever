# 设置目标架构为x86
export ARCH=x86

# 编译器设置
CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -pthread
TARGET = atomk_test_x86
SOURCE = atomk_test.c

# 默认目标
all: $(TARGET)

# 编译目标文件
$(TARGET): $(SOURCE)
	@echo "编译x86版本的原子性测试程序..."
	$(CC) $(CFLAGS) -o $@ $<
	@echo "编译完成！输出文件: $@"

# 清理生成的文件
clean:
	@echo "清理x86编译输出..."
	@rm -f $(TARGET)
	@echo "清理完成！"

.PHONY: all clean