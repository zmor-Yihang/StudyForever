# 内核构建系统配置文件
# 设置项目名和源文件名
PROJECT_NAME := LED
SOURCE_FILES := led.c char_dev_register.c

# 源文件目录
SRC_DIR := $(M)/../user

# 添加C99标准支持，添加源文件目录到头文件搜索路径
ccflags-y := -std=gnu99 -I$(SRC_DIR)

# 告诉内核构建系统要编译的模块
obj-m := $(PROJECT_NAME).o
$(PROJECT_NAME)-objs := $(addprefix ../user/,$(SOURCE_FILES:.c=.o))
